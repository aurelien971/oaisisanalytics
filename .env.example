DASHBOARD_PASSWORD=pick-something-long
AUTH_SECRET=openssl rand -hex 32

# One service account per product, base64 of the JSON, no newlines:
#   base64 -i serviceAccount.<product>.json | tr -d '\n'
# Set each for Production, Preview and Development. Locally you can instead drop
# the raw serviceAccount.<product>.json in the repo root — both are gitignored.
OPAQUE_SERVICE_ACCOUNT_B64=base64 of the opaque-3964b service account JSON
OAISISLABS_SERVICE_ACCOUNT_B64=base64 of the oaisislabs service account JSON
OAISIS_SERVICE_ACCOUNT_B64=base64 of the oaisis-a6968 service account JSON
FAIKE_SERVICE_ACCOUNT_B64=base64 of the faike-2828d service account JSON
SURRENDER_SERVICE_ACCOUNT_B64=base64 of the surrender-e927a service account JSON
COMPLAINR_SERVICE_ACCOUNT_B64=base64 of the complainr-7c472 service account JSON
# Hineni has no service account yet — the page shows "Not connected" until it does.
HINENI_SERVICE_ACCOUNT_B64=base64 of the hineni service account JSON
